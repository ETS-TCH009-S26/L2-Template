{
    // --- Consigne pédagogique du cours : aucune autocomplétion ---------------
    // Le but est d'apprendre la syntaxe du C, pas de la faire deviner par
    // l'éditeur. Les erreurs de compilation restent affichées, elles.
    "editor.quickSuggestions": {
        "other": false,
        "comments": false,
        "strings": false
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabCompletion": "off",
    "editor.parameterHints.enabled": false,
    "editor.inlineSuggest.enabled": false,
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.suggestSnippets": false,
    "C_Cpp.autocompleteAddParentheses": false,
    "github.copilot.enable": {
        "*": false
    },

    // --- Édition ------------------------------------------------------------
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",

    // --- CMake --------------------------------------------------------------
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    "cmake.options.statusBarVisibility": "visible",

    // --- Orthographe (commentaires en français) -----------------------------
    "cSpell.language": "fr,en"
}
